{
  "manifestVersion": 5,
  "id": "com.unn0wn002.audio-preflight.beta",
  "name": "Audio Preflight - Private Beta",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.5.2"
  },
  "requiredPermissions": { "localFileSystem": "request" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "audio-routing-integrity-probe",
      "label": {
        "default": "Audio Preflight"
      },
      "minimumSize": {
        "width": 320,
        "height": 300
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 560,
        "height": 720
      }
    }
  ]
}
